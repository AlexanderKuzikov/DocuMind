    },
    {
      "id": "contract_date",
      "label": "Дата договора",
      "type": "date",
      "required": true,
      "normalization": ["date"],
      "extractionHint": "Дата договора УПТ, например 28.12.2023. Брать из заголовка рядом с номером.",
      "aliases": ["document_date", "date", "contract_date", "дата договора"]
    },
    {
      "id": "debtor",
      "label": "Должник",
      "type": "string",
      "required": true,
      "normalization": ["trim"],
      "extractionHint": "Должник — лицо, к которому уступается требование (виновник ДТП/страховая).",
      "aliases": ["debtor_name", "должник"]
    },
    {
      "id": "cedent",
      "label": "Цедент",
      "type": "string",
