{
  "type": "upt_rights",
  "name": "Договор уступки прав (УПТ)",
  "aliases": [
    "Договор уступки прав",
    "Договор УПТ",
    "УПТ"
  ],
  "recognitionFeatures": [
    "Заголовок «Договор уступки прав (требования)» с аббревиатурой УПТ.",
    "Номер с суффиксом УПТ (например, 05-08-2024-УПТ-2), без Ю.",
    "Предмет: уступка прав требования возмещения ущерба ДТП.",
    "Стороны: цедент (потерпевший) и цессионарий."
  ],
  "fields": [
    {
      "id": "contract_number",
      "label": "Номер договора УПТ",
      "type": "string",
      "required": true,
      "normalization": ["trim"],
      "extractionHint": "Номер договора УПТ, например 28/12/2023/УПТ-8. Брать из заголовка или шапки.",
