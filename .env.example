# DocuMind environment example.
# Copy variables to your secure environment or Hermes .env.
# Do not commit real secrets.

ROUTERAI_API_KEY=sk-
INTERNAL_LLM_API_KEY=

# Office Ollama (prod-ollama profile) — один из двух способов задать IP:
# 1) через UI: npm run ui -> Config -> llm.profiles.prod-ollama.baseUrl
# 2) через .env (приоритет): раскомментируй и укажи IP офисного сервера
# OLLAMA_BASE_URL=http://192.168.1.100:11434/v1
# DOCUMIND_ACTIVE_PROFILE=prod-ollama

